		case 0:
			shine = screen(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 1:
			shine = multiply(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 2:
			shine = darken(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 3:
			shine = lighten(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 4:
