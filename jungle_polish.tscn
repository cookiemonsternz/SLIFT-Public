			break;
		case 7:
			shine = hard_light(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 8:
			shine = soft_light(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 9:
			shine = color_dodge(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 10:
			shine = linear_dodge(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 11:
			shine = color_burn(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
		case 12:
			shine = linear_burn(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(color)).rgb;
			break;
	}
	
	COLOR = vec4(shine, rays * color.a);
}"

